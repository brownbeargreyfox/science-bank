# Copy to .env and fill in real values before `docker compose up -d --build`.
# .env is gitignored — never commit it.

# --- Database -------------------------------------------------------------------------------
POSTGRES_USER=science_bank
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=science_bank

# --- App ------------------------------------------------------------------------------------
# "production" enables Secure cookies, disables /docs, and refuses to start with a weak JWT_SECRET.
ENVIRONMENT=production
# At least 32 random characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The app binds here on the host; point Caddy at it (see README "Deploying behind Caddy").
APP_BIND=127.0.0.1
APP_PORT=8420

# --- Teacher account -------------------------------------------------------------------------
# Recommended: leave TEACHER_PASSWORD_HASH empty and set the password after first start with
#   docker compose exec app python -m app.cli set-password
# (stores a bcrypt hash in the database; re-run any time to change it).
TEACHER_USERNAME=nina
# Optional bootstrap, used only when no account exists yet. Docker Compose interpolates "$", so
# every "$" in the bcrypt hash must be doubled: $2b$12$abc... -> $$2b$$12$$abc...
TEACHER_PASSWORD_HASH=
