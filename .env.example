# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets or password hashes.

POSTGRES_USER=science_bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=science_bank

# Single-teacher MVP auth (see PROJECT_STATUS.md section 4.4 — Phase 1).
TEACHER_USERNAME=nina
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
# Docker Compose interpolates $ in .env values, so double every $ in the bcrypt hash
# (e.g. $2b$12$abc... -> $$2b$$12$$abc...) or the hash will be silently mangled.
TEACHER_PASSWORD_HASH=

JWT_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development

# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173"]
